[Unit]
Description=NetBox <- Proxmox VE VM synchronization agent (netbox-pve-sync)
Documentation=file:///opt/netbox-pve-sync/README.md
After=network-online.target pveproxy.service
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
Type=simple
User=netbox-pve-sync
Group=netbox-pve-sync
Environment=PYTHONPATH=/opt/netbox-pve-sync/lib
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m netbox_pve_sync --config /etc/netbox-pve-sync/config.yaml run

# Restart after crashes, but not after a configuration error (exit 78 = EX_CONFIG):
# fix the config, then `systemctl restart netbox-pve-sync`.
Restart=on-failure
RestartSec=15s
RestartPreventExitStatus=78

# SIGTERM finishes the current API call (max. one HTTP timeout) and exits.
KillSignal=SIGTERM
TimeoutStopSec=45s

# Logs go to journald: journalctl -u netbox-pve-sync
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netbox-pve-sync

# State: /var/lib/netbox-pve-sync (SQLite retry queue), created by systemd.
StateDirectory=netbox-pve-sync
StateDirectoryMode=0750
UMask=0027

# Hardening. The agent only needs: read its config, write its state dir, make
# outbound HTTP(S) connections to 127.0.0.1:8006 (Proxmox) and NetBox.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadOnlyPaths=/etc/netbox-pve-sync
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
