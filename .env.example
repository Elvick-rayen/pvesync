# Copy to /etc/netbox-pve-sync/secrets.env (install.sh does this for you):
#   install -m 0640 -o root -g netbox-pve-sync .env.example /etc/netbox-pve-sync/secrets.env
# Never commit the real file. Values here are placeholders.

# NetBox API token (Admin > API Tokens). v1 tokens are 40 hex chars;
# NetBox 4.5+ v2 tokens look like nbt_<key>.<secret>.
NETBOX_API_TOKEN=replace-me

# Secret of the Proxmox API token named in proxmox.token_id (created by install.sh).
PVE_TOKEN_SECRET=replace-me
